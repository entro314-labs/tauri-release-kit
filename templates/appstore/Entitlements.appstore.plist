<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for every App Store submission. Verify the app still works
	     under the sandbox BEFORE submitting: file access outside the
	     container, arbitrary subprocesses and raw sockets all stop working. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- $TEAM_ID is the "App ID Prefix" on your identifier's page;
	     $IDENTIFIER is tauri.conf.json > identifier. -->
	<key>com.apple.application-identifier</key>
	<string>$TEAM_ID.$IDENTIFIER</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$TEAM_ID</string>

	<!-- Add ONLY the capabilities the app actually uses. Each one is a
	     review question. -->
	<!--
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	-->
</dict>
</plist>
